<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Workorder" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Workorder" name="工单业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Workorder"><bpmn:lane id="Lane_Process_Workorder_1" name="客户/员工/AIWA"><bpmn:flowNodeRef>W1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Workorder_2" name="客服/运营"><bpmn:flowNodeRef>W3</bpmn:flowNodeRef><bpmn:flowNodeRef>W5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Workorder_3" name="维修/仓务"><bpmn:flowNodeRef>W4</bpmn:flowNodeRef><bpmn:flowNodeRef>W6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Workorder_4" name="运营后台"><bpmn:flowNodeRef>W2</bpmn:flowNodeRef><bpmn:flowNodeRef>W7</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="W1" name="报修或异常"><bpmn:outgoing>Flow_Process_Workorder_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="W2" name="分类优先级与派单"><bpmn:incoming>Flow_Process_Workorder_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Workorder_2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="W3" name="受理/补充资料"><bpmn:incoming>Flow_Process_Workorder_2</bpmn:incoming><bpmn:outgoing>Flow_Process_Workorder_3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="W4" name="到场处理并留证"><bpmn:incoming>Flow_Process_Workorder_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Workorder_4</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="W5" name="复核结果"><bpmn:incoming>Flow_Process_Workorder_4</bpmn:incoming><bpmn:incoming>Flow_Process_Workorder_7</bpmn:incoming><bpmn:outgoing>Flow_Process_Workorder_5</bpmn:outgoing><bpmn:outgoing>Flow_Process_Workorder_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="W6" name="整改重报"><bpmn:incoming>Flow_Process_Workorder_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Workorder_7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="W7" name="解决并关闭"><bpmn:incoming>Flow_Process_Workorder_5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Workorder_1" sourceRef="W1" targetRef="W2" /><bpmn:sequenceFlow id="Flow_Process_Workorder_2" sourceRef="W2" targetRef="W3" /><bpmn:sequenceFlow id="Flow_Process_Workorder_3" sourceRef="W3" targetRef="W4" /><bpmn:sequenceFlow id="Flow_Process_Workorder_4" sourceRef="W4" targetRef="W5" /><bpmn:sequenceFlow id="Flow_Process_Workorder_5" sourceRef="W5" targetRef="W7" name="通过" /><bpmn:sequenceFlow id="Flow_Process_Workorder_6" sourceRef="W5" targetRef="W6" name="退回" /><bpmn:sequenceFlow id="Flow_Process_Workorder_7" sourceRef="W6" targetRef="W5" /></bpmn:process></bpmn:definitions>