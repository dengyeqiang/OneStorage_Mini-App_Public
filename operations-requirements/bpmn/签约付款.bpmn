<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Payment" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Payment" name="签约付款业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Payment"><bpmn:lane id="Lane_Process_Payment_1" name="客户小程序"><bpmn:flowNodeRef>P1</bpmn:flowNodeRef><bpmn:flowNodeRef>P3</bpmn:flowNodeRef><bpmn:flowNodeRef>P7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Payment_2" name="销售/财务"><bpmn:flowNodeRef>P5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Payment_3" name="支付/签约服务"><bpmn:flowNodeRef>P4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Payment_4" name="运营后台"><bpmn:flowNodeRef>P2</bpmn:flowNodeRef><bpmn:flowNodeRef>P6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="P1" name="确认订单"><bpmn:outgoing>Flow_Process_Payment_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="P2" name="生成合同与应收"><bpmn:incoming>Flow_Process_Payment_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Payment_2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="P3" name="电子签名/上传凭证"><bpmn:incoming>Flow_Process_Payment_2</bpmn:incoming><bpmn:incoming>Flow_Process_Payment_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Payment_3</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="P4" name="支付或签署回调"><bpmn:incoming>Flow_Process_Payment_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Payment_4</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="P5" name="核实成功"><bpmn:incoming>Flow_Process_Payment_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Payment_5</bpmn:outgoing><bpmn:outgoing>Flow_Process_Payment_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="P6" name="激活合同与履约"><bpmn:incoming>Flow_Process_Payment_5</bpmn:incoming><bpmn:outgoing>Flow_Process_Payment_7</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="P7" name="订单生效"><bpmn:incoming>Flow_Process_Payment_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Payment_1" sourceRef="P1" targetRef="P2" /><bpmn:sequenceFlow id="Flow_Process_Payment_2" sourceRef="P2" targetRef="P3" /><bpmn:sequenceFlow id="Flow_Process_Payment_3" sourceRef="P3" targetRef="P4" /><bpmn:sequenceFlow id="Flow_Process_Payment_4" sourceRef="P4" targetRef="P5" /><bpmn:sequenceFlow id="Flow_Process_Payment_5" sourceRef="P5" targetRef="P6" name="是" /><bpmn:sequenceFlow id="Flow_Process_Payment_6" sourceRef="P5" targetRef="P3" name="否/补充" /><bpmn:sequenceFlow id="Flow_Process_Payment_7" sourceRef="P6" targetRef="P7" /></bpmn:process></bpmn:definitions>