<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Renewal" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Renewal" name="续租业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Renewal"><bpmn:lane id="Lane_Process_Renewal_1" name="客户小程序"><bpmn:flowNodeRef>R4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Renewal_2" name="客服/销售"><bpmn:flowNodeRef>R3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Renewal_3" name="运营后台"><bpmn:flowNodeRef>R1</bpmn:flowNodeRef><bpmn:flowNodeRef>R2</bpmn:flowNodeRef><bpmn:flowNodeRef>R6</bpmn:flowNodeRef><bpmn:flowNodeRef>R7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Renewal_4" name="支付/签约服务"><bpmn:flowNodeRef>R5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="R1" name="到期触发或客户申请"><bpmn:outgoing>Flow_Process_Renewal_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="R2" name="生成续租订单/报价"><bpmn:incoming>Flow_Process_Renewal_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Renewal_2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="R3" name="核对期限与优惠"><bpmn:incoming>Flow_Process_Renewal_2</bpmn:incoming><bpmn:incoming>Flow_Process_Renewal_7</bpmn:incoming><bpmn:outgoing>Flow_Process_Renewal_3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="R4" name="确认方案及自动续费"><bpmn:incoming>Flow_Process_Renewal_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Renewal_4</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="R5" name="签补充合约并付款"><bpmn:incoming>Flow_Process_Renewal_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Renewal_5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="R6" name="付款成功"><bpmn:incoming>Flow_Process_Renewal_5</bpmn:incoming><bpmn:outgoing>Flow_Process_Renewal_6</bpmn:outgoing><bpmn:outgoing>Flow_Process_Renewal_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="R7" name="延长租期"><bpmn:incoming>Flow_Process_Renewal_6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Renewal_1" sourceRef="R1" targetRef="R2" /><bpmn:sequenceFlow id="Flow_Process_Renewal_2" sourceRef="R2" targetRef="R3" /><bpmn:sequenceFlow id="Flow_Process_Renewal_3" sourceRef="R3" targetRef="R4" /><bpmn:sequenceFlow id="Flow_Process_Renewal_4" sourceRef="R4" targetRef="R5" /><bpmn:sequenceFlow id="Flow_Process_Renewal_5" sourceRef="R5" targetRef="R6" /><bpmn:sequenceFlow id="Flow_Process_Renewal_6" sourceRef="R6" targetRef="R7" name="是" /><bpmn:sequenceFlow id="Flow_Process_Renewal_7" sourceRef="R6" targetRef="R3" name="失败/人工处理" /></bpmn:process></bpmn:definitions>