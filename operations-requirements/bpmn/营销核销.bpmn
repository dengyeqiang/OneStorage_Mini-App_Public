<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Marketing" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Marketing" name="营销核销业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Marketing"><bpmn:lane id="Lane_Process_Marketing_1" name="运营"><bpmn:flowNodeRef>G1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Marketing_2" name="客户小程序"><bpmn:flowNodeRef>G4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Marketing_3" name="订单中心"><bpmn:flowNodeRef>G5</bpmn:flowNodeRef><bpmn:flowNodeRef>G6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Marketing_4" name="营销后台"><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>G7</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="G1" name="创建活动/券/推荐码"><bpmn:outgoing>Flow_Process_Marketing_1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="G2" name="配置范围库存与有效期"><bpmn:incoming>Flow_Process_Marketing_1</bpmn:incoming><bpmn:incoming>Flow_Process_Marketing_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Marketing_2</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G3" name="审核发布"><bpmn:incoming>Flow_Process_Marketing_2</bpmn:incoming><bpmn:outgoing>Flow_Process_Marketing_3</bpmn:outgoing><bpmn:outgoing>Flow_Process_Marketing_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="G4" name="领取或输入推荐码"><bpmn:incoming>Flow_Process_Marketing_3</bpmn:incoming><bpmn:incoming>Flow_Process_Marketing_8</bpmn:incoming><bpmn:outgoing>Flow_Process_Marketing_5</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="G5" name="下单资格与叠加校验"><bpmn:incoming>Flow_Process_Marketing_5</bpmn:incoming><bpmn:outgoing>Flow_Process_Marketing_6</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="G6" name="支付成功"><bpmn:incoming>Flow_Process_Marketing_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Marketing_7</bpmn:outgoing><bpmn:outgoing>Flow_Process_Marketing_8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="G7" name="核销并归因"><bpmn:incoming>Flow_Process_Marketing_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Marketing_1" sourceRef="G1" targetRef="G2" /><bpmn:sequenceFlow id="Flow_Process_Marketing_2" sourceRef="G2" targetRef="G3" /><bpmn:sequenceFlow id="Flow_Process_Marketing_3" sourceRef="G3" targetRef="G4" name="通过" /><bpmn:sequenceFlow id="Flow_Process_Marketing_4" sourceRef="G3" targetRef="G2" name="退回" /><bpmn:sequenceFlow id="Flow_Process_Marketing_5" sourceRef="G4" targetRef="G5" /><bpmn:sequenceFlow id="Flow_Process_Marketing_6" sourceRef="G5" targetRef="G6" /><bpmn:sequenceFlow id="Flow_Process_Marketing_7" sourceRef="G6" targetRef="G7" name="是" /><bpmn:sequenceFlow id="Flow_Process_Marketing_8" sourceRef="G6" targetRef="G4" name="失败/释放" /></bpmn:process></bpmn:definitions>