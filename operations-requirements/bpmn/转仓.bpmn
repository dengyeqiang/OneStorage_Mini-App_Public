<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Transfer" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Transfer" name="转仓业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Transfer"><bpmn:lane id="Lane_Process_Transfer_1" name="客户小程序"><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Transfer_2" name="销售/运营"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Transfer_3" name="仓务"><bpmn:flowNodeRef>T6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Transfer_4" name="运营后台"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="T1" name="提交转仓意向"><bpmn:outgoing>Flow_Process_Transfer_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="T2" name="校验合同与欠费"><bpmn:incoming>Flow_Process_Transfer_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Transfer_2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="T3" name="选择目标仓位报价"><bpmn:incoming>Flow_Process_Transfer_2</bpmn:incoming><bpmn:incoming>Flow_Process_Transfer_5</bpmn:incoming><bpmn:outgoing>Flow_Process_Transfer_3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="T4" name="锁仓成功"><bpmn:incoming>Flow_Process_Transfer_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Transfer_4</bpmn:outgoing><bpmn:outgoing>Flow_Process_Transfer_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T5" name="确认差额与时段"><bpmn:incoming>Flow_Process_Transfer_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Transfer_6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T6" name="执行搬仓验收"><bpmn:incoming>Flow_Process_Transfer_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Transfer_7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="T7" name="切换合约并释放旧仓"><bpmn:incoming>Flow_Process_Transfer_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Transfer_1" sourceRef="T1" targetRef="T2" /><bpmn:sequenceFlow id="Flow_Process_Transfer_2" sourceRef="T2" targetRef="T3" /><bpmn:sequenceFlow id="Flow_Process_Transfer_3" sourceRef="T3" targetRef="T4" /><bpmn:sequenceFlow id="Flow_Process_Transfer_4" sourceRef="T4" targetRef="T5" name="是" /><bpmn:sequenceFlow id="Flow_Process_Transfer_5" sourceRef="T4" targetRef="T3" name="否/重选" /><bpmn:sequenceFlow id="Flow_Process_Transfer_6" sourceRef="T5" targetRef="T6" /><bpmn:sequenceFlow id="Flow_Process_Transfer_7" sourceRef="T6" targetRef="T7" /></bpmn:process></bpmn:definitions>