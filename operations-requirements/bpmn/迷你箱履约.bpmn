<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Box" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Box" name="迷你箱履约业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Box"><bpmn:lane id="Lane_Process_Box_1" name="客户小程序"><bpmn:flowNodeRef>B1</bpmn:flowNodeRef><bpmn:flowNodeRef>B4</bpmn:flowNodeRef><bpmn:flowNodeRef>B6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Box_2" name="客服"><bpmn:flowNodeRef>B2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Box_3" name="配送/仓务"><bpmn:flowNodeRef>B3</bpmn:flowNodeRef><bpmn:flowNodeRef>B5</bpmn:flowNodeRef><bpmn:flowNodeRef>B7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Box_4" name="运营后台"><bpmn:flowNodeRef>B8</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="B1" name="选套餐并签约付款"><bpmn:outgoing>Flow_Process_Box_1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="B2" name="确认送箱预约"><bpmn:incoming>Flow_Process_Box_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Box_2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="B3" name="配送空箱"><bpmn:incoming>Flow_Process_Box_2</bpmn:incoming><bpmn:outgoing>Flow_Process_Box_3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="B4" name="装箱并预约取箱"><bpmn:incoming>Flow_Process_Box_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Box_4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="B5" name="取箱/扫码配对/入仓"><bpmn:incoming>Flow_Process_Box_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Box_5</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="B6" name="召回或退租"><bpmn:incoming>Flow_Process_Box_5</bpmn:incoming><bpmn:outgoing>Flow_Process_Box_6</bpmn:outgoing><bpmn:outgoing>Flow_Process_Box_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="B7" name="配送/回收/最终取物"><bpmn:incoming>Flow_Process_Box_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Box_8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="B8" name="归档或继续在仓"><bpmn:incoming>Flow_Process_Box_7</bpmn:incoming><bpmn:incoming>Flow_Process_Box_8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Box_1" sourceRef="B1" targetRef="B2" /><bpmn:sequenceFlow id="Flow_Process_Box_2" sourceRef="B2" targetRef="B3" /><bpmn:sequenceFlow id="Flow_Process_Box_3" sourceRef="B3" targetRef="B4" /><bpmn:sequenceFlow id="Flow_Process_Box_4" sourceRef="B4" targetRef="B5" /><bpmn:sequenceFlow id="Flow_Process_Box_5" sourceRef="B5" targetRef="B6" /><bpmn:sequenceFlow id="Flow_Process_Box_6" sourceRef="B6" targetRef="B7" name="申请服务" /><bpmn:sequenceFlow id="Flow_Process_Box_7" sourceRef="B6" targetRef="B8" name="继续存放" /><bpmn:sequenceFlow id="Flow_Process_Box_8" sourceRef="B7" targetRef="B8" /></bpmn:process></bpmn:definitions>