<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Sales" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Sales" name="销售转化业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Sales"><bpmn:lane id="Lane_Process_Sales_1" name="客户/小程序/AIWA"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Sales_2" name="销售"><bpmn:flowNodeRef>S3</bpmn:flowNodeRef><bpmn:flowNodeRef>S4</bpmn:flowNodeRef><bpmn:flowNodeRef>S5</bpmn:flowNodeRef><bpmn:flowNodeRef>S6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Sales_3" name="运营后台"><bpmn:flowNodeRef>S2</bpmn:flowNodeRef><bpmn:flowNodeRef>S7</bpmn:flowNodeRef><bpmn:flowNodeRef>S8</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S1" name="产生咨询"><bpmn:outgoing>Flow_Process_Sales_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="S2" name="去重并生成L"><bpmn:incoming>Flow_Process_Sales_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Sales_2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="S3" name="资格与意向确认"><bpmn:incoming>Flow_Process_Sales_2</bpmn:incoming><bpmn:outgoing>Flow_Process_Sales_3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="S4" name="转化路径"><bpmn:incoming>Flow_Process_Sales_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Sales_4</bpmn:outgoing><bpmn:outgoing>Flow_Process_Sales_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="S5" name="建立看仓预约"><bpmn:incoming>Flow_Process_Sales_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Sales_6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="S6" name="建立OP并报价"><bpmn:incoming>Flow_Process_Sales_5</bpmn:incoming><bpmn:incoming>Flow_Process_Sales_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Sales_7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="S7" name="创建SO并审批"><bpmn:incoming>Flow_Process_Sales_7</bpmn:incoming><bpmn:outgoing>Flow_Process_Sales_8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="S8" name="进入签约付款"><bpmn:incoming>Flow_Process_Sales_8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Sales_1" sourceRef="S1" targetRef="S2" /><bpmn:sequenceFlow id="Flow_Process_Sales_2" sourceRef="S2" targetRef="S3" /><bpmn:sequenceFlow id="Flow_Process_Sales_3" sourceRef="S3" targetRef="S4" /><bpmn:sequenceFlow id="Flow_Process_Sales_4" sourceRef="S4" targetRef="S5" name="需看仓" /><bpmn:sequenceFlow id="Flow_Process_Sales_5" sourceRef="S4" targetRef="S6" name="可报价" /><bpmn:sequenceFlow id="Flow_Process_Sales_6" sourceRef="S5" targetRef="S6" /><bpmn:sequenceFlow id="Flow_Process_Sales_7" sourceRef="S6" targetRef="S7" /><bpmn:sequenceFlow id="Flow_Process_Sales_8" sourceRef="S7" targetRef="S8" /></bpmn:process></bpmn:definitions>