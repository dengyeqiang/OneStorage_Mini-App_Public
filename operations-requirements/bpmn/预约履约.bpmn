<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Appointment" targetNamespace="https://onestorage.hk/bpmn"><bpmn:process id="Process_Appointment" name="预约履约业务流程" isExecutable="false"><bpmn:laneSet id="LaneSet_Process_Appointment"><bpmn:lane id="Lane_Process_Appointment_1" name="客户小程序"><bpmn:flowNodeRef>A1</bpmn:flowNodeRef><bpmn:flowNodeRef>A7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Appointment_2" name="销售/客服"><bpmn:flowNodeRef>A3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Appointment_3" name="仓务/物流"><bpmn:flowNodeRef>A4</bpmn:flowNodeRef><bpmn:flowNodeRef>A5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Process_Appointment_4" name="运营后台"><bpmn:flowNodeRef>A2</bpmn:flowNodeRef><bpmn:flowNodeRef>A6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="A1" name="提交预约"><bpmn:outgoing>Flow_Process_Appointment_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="A2" name="校验客户与订单"><bpmn:incoming>Flow_Process_Appointment_1</bpmn:incoming><bpmn:outgoing>Flow_Process_Appointment_2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="A3" name="确认或改期"><bpmn:incoming>Flow_Process_Appointment_2</bpmn:incoming><bpmn:incoming>Flow_Process_Appointment_6</bpmn:incoming><bpmn:outgoing>Flow_Process_Appointment_3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="A4" name="执行服务"><bpmn:incoming>Flow_Process_Appointment_3</bpmn:incoming><bpmn:outgoing>Flow_Process_Appointment_4</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="A5" name="执行结果"><bpmn:incoming>Flow_Process_Appointment_4</bpmn:incoming><bpmn:outgoing>Flow_Process_Appointment_5</bpmn:outgoing><bpmn:outgoing>Flow_Process_Appointment_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="A6" name="同步订单/机会"><bpmn:incoming>Flow_Process_Appointment_5</bpmn:incoming><bpmn:outgoing>Flow_Process_Appointment_7</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="A7" name="客户收到结果"><bpmn:incoming>Flow_Process_Appointment_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Process_Appointment_1" sourceRef="A1" targetRef="A2" /><bpmn:sequenceFlow id="Flow_Process_Appointment_2" sourceRef="A2" targetRef="A3" /><bpmn:sequenceFlow id="Flow_Process_Appointment_3" sourceRef="A3" targetRef="A4" /><bpmn:sequenceFlow id="Flow_Process_Appointment_4" sourceRef="A4" targetRef="A5" /><bpmn:sequenceFlow id="Flow_Process_Appointment_5" sourceRef="A5" targetRef="A6" name="完成" /><bpmn:sequenceFlow id="Flow_Process_Appointment_6" sourceRef="A5" targetRef="A3" name="改期/异常" /><bpmn:sequenceFlow id="Flow_Process_Appointment_7" sourceRef="A6" targetRef="A7" /></bpmn:process></bpmn:definitions>